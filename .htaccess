# Increase PHP limits for large media uploads (XAMPP/Apache mod_php).
<IfModule php_module>
    php_value upload_max_filesize 512M
    php_value post_max_size 520M
    php_value max_execution_time 600
    php_value max_input_time 600
    php_value memory_limit 512M
</IfModule>

# Compatibility for some Apache module names.
<IfModule mod_php.c>
    php_value upload_max_filesize 512M
    php_value post_max_size 520M
    php_value max_execution_time 600
    php_value max_input_time 600
    php_value memory_limit 512M
</IfModule>

<IfModule mod_php8.c>
    php_value upload_max_filesize 512M
    php_value post_max_size 520M
    php_value max_execution_time 600
    php_value max_input_time 600
    php_value memory_limit 512M
</IfModule>
